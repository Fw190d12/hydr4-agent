{
  "$schema": "https://opencode.ai/config.json",
  "model": "hydr4/nemotron-3-ultra-550b",
  "provider": {
    "hydr4": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Hydra Aggregator",
      "env": ["HYDRA_API_KEY"],
      "options": {
        "baseURL": "http://aggregator:3001/v1",
        "timeout": 600000
      },
      "models": {
        "nemotron-3-ultra-550b": {
          "name": "NVIDIA Nemotron 550B",
          "tool_call": true
        },
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 (AMD/NVIDIA)",
          "tool_call": true,
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" }
        }
      }
    }
  }
}
