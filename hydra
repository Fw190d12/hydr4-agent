#!/usr/bin/env bash

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

case "$1" in
    start)
        echo -e "${YELLOW}Запуск Hydra (Агрегатор + Агент)...${NC}"
        docker compose --profile opencode up -d
        echo -e "${GREEN}Готово!${NC}"
        echo -e "• Web UI (OpenCode Agent): http://localhost:4096"
        echo -e "• Web UI (FreeLLMAPI): http://localhost:3001"
        ;;
    stop)
        echo -e "${YELLOW}Остановка Hydra...${NC}"
        docker compose --profile opencode down
        ;;
    web)
        echo -e "Открой в браузере: ${GREEN}http://localhost:4096${NC}"
        ;;
    cli)
        echo -e "${YELLOW}Открытие терминала внутри агента...${NC}"
        docker compose exec agent bash
        ;;
    *)
        echo "Использование: ./hydra {start|stop|web|cli}"
        exit 1
        ;;
esac
