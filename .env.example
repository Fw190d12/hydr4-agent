# ==========================================
# hydr4-agent Environment Variables
# ==========================================
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env

# --- Core Infrastructure ---
# The image for the aggregator (pinned for reproducibility)
AGGREGATOR_IMAGE=ghcr.io/tashfeenahmed/freellmapi@sha256:da6829d4ae510b968aa8bea6817a3647f5396c312392bbf44f47942d0aec2d96

# The port on which the aggregator UI will be exposed locally
AGGREGATOR_PORT=3001

# The upstream proxy to use for outbound LLM traffic (WSL2 -> mihomo)
# Note: In WSL2 mirrored mode, we must use the Docker bridge IP.
UPSTREAM_PROXY=http://172.17.0.1:7890

# --- Secrets & Keys (REQUIRED) ---
# Generate a random 32-byte hex string (e.g., `openssl rand -hex 32`)
ENCRYPTION_KEY=

# The master key generated by FreeLLMAPI on the first run (check logs or UI)
FREELMAPI_UNIFIED_KEY=

# --- Agent SSH Keys ---
# Path to a folder containing SSH keys for the agent (e.g., id_ed25519).
# Defaults to './empty-ssh-dir' if not set.
AGENT_SSH_DIR=

# Password to access the OpenCode Web UI
OPENCODE_PASSWORD=mysecretpassword

# --- Agent Configuration ---
# Which agent to run: "opencode" or "dsh"
AGENT_TYPE=opencode

# --- Optional: Direct Provider Keys ---
# Note: Usually added via the FreeLLMAPI UI, but can be passed here if needed.
# GOOGLE_AI_STUDIO_API_KEY=
# DEEPSEEK_API_KEY=
